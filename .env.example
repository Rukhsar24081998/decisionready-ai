# Groq — required for Decision Intelligence generation
GROQ_API_KEY=your_api_key_here

# Primary model (automatic fallback to qwen/qwen3.6-27b if unavailable)
GROQ_MODEL=openai/gpt-oss-120b

# Vercel Blob — required on Vercel so analyses persist across serverless instances
# Create a Blob store in the Vercel dashboard, then paste the read/write token here.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
